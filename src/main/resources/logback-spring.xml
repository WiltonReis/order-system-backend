<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Perfil de desenvolvimento: saída legível no console com correlação de request -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-?} %X{tenantId:-?} %X{userId:-?}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.ordersystem" level="DEBUG"/>
    </springProfile>

    <!-- Perfil de produção: JSON estruturado compatível com Logstash/Elasticsearch -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>tenantId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>

        <logger name="com.ordersystem" level="WARN"/>
    </springProfile>

</configuration>
